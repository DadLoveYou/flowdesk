{
  "name": "flowdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node build/server/index.js",
    "test": "tsx --test tests/api.test.ts tests/domain.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "idb": "^8.0.2",
    "lucide-vue-next": "^0.468.0",
    "multer": "^2.0.2",
    "pinia": "^2.3.1",
    "spark-md5": "^3.0.2",
    "sql.js": "^1.13.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "@types/spark-md5": "^3.0.5",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^3.3.14"
  }
}
